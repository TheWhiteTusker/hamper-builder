# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template committed
!.env.local.example

# Public build-time config, deliberately committed - see the file's header.
!.env.production

# Skill symlinks point at absolute local paths, so they are per-machine.
# The skills themselves live in .agents/ and are committed.
.claude/*
# Shared project settings (plugins such as ponytail) are committed.
!.claude/settings.json

# Cloudflare Workers build output
.open-next/
.wrangler/

# Local-only pnpm layout override for Windows symlink limits.
.npmrc

# Auto-generated agent rules by Next.js
AGENTS.md
CLAUDE.md
