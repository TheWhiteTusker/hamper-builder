{"nodes": [{"id": "_agents_skills_supabase_skill", "label": "Supabase Agent Skill", "file_type": "document", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Agent instructions for any Supabase task: Database, Auth, Edge Functions, Realtime, Storage, CLI, MCP, migrations, security audits, debugging."}, {"id": "_agents_skills_supabase_skill_verify_against_changelog", "label": "Verify against Supabase changelog and current docs", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Supabase changes frequently; training data is unreliable, so fetch supabase.com/changelog.md and scan for breaking-change tags first."}, {"id": "_agents_skills_supabase_skill_verify_your_work", "label": "Verify your work with a test query", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "A fix without verification is incomplete."}, {"id": "_agents_skills_supabase_skill_recover_dont_loop", "label": "Recover from errors, don't loop", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "After 2-3 failed attempts, change method, check docs and logs instead of retrying the same command."}, {"id": "_agents_skills_supabase_skill_data_api_exposure", "label": "Exposing tables to the Data API", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "New tables may not be auto-exposed; anon/authenticated need explicit GRANT. Separate from RLS, which controls rows not table access."}, {"id": "_agents_skills_supabase_skill_rls_exposed_schemas", "label": "RLS on every table in exposed schemas", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Tables in exposed schemas (public by default) are reachable via the Data API; policies should match the real access model, not a blanket auth.uid() pattern."}, {"id": "_agents_skills_supabase_skill_security_checklist", "label": "Supabase security checklist", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Supabase-specific traps that silently create vulnerabilities across auth, keys, RLS, views, storage and dependencies."}, {"id": "_agents_skills_supabase_skill_supabase_cli", "label": "Supabase CLI (discover via --help)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "CLI structure changes between versions, so never guess commands. db query needs v2.79.0+, db advisors v2.81.3+; create migrations with `supabase migration new`."}, {"id": "_agents_skills_supabase_skill_supabase_mcp_server", "label": "Supabase MCP server", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Troubleshoot in order: reachability (401 is healthy), .mcp.json config, OAuth 2.1 authentication."}, {"id": "_agents_skills_supabase_skill_documentation_lookup", "label": "Supabase documentation lookup order", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Priority: MCP search_docs, then docs pages fetched as .md, then web search."}, {"id": "_agents_skills_supabase_skill_declarative_schemas", "label": "Declarative schemas workflow", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Used when supabase/schemas/ exists or config.toml sets schema_paths; edit desired state and generate migrations rather than hand-writing them."}, {"id": "_agents_skills_supabase_skill_imperative_migrations", "label": "Imperative migrations workflow", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Iterate with execute_sql / supabase db query; never apply_migration locally because it writes history on every call and breaks db diff/pull. Commit via advisors, checklist review, db pull, migration list."}, {"id": "_agents_skills_supabase_skill_db_advisors", "label": "supabase db advisors / MCP get_advisors", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_debugging_workflow", "label": "Supabase debugging workflow", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Must fetch the Monitoring and Debugging docs before diagnosing Supabase errors rather than working from memory."}, {"id": "_agents_skills_supabase_skill_app_metadata_authorization", "label": "Use app_metadata, never user_metadata, for authorization", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "raw_user_meta_data is user-editable and appears in auth.jwt(); JWT claims may be stale until token refresh."}, {"id": "_agents_skills_supabase_skill_session_revocation", "label": "Deleting a user does not invalidate access tokens", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Revoke sessions first, keep JWT expiry short, validate session_id against auth.sessions for strict guarantees."}, {"id": "_agents_skills_supabase_skill_service_role_key_exposure", "label": "Never expose service_role key in public clients", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Prefer publishable keys; any NEXT_PUBLIC_ env var is sent to the browser."}, {"id": "_agents_skills_supabase_skill_security_invoker_views", "label": "Views bypass RLS (use security_invoker)", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "On Postgres 15+ use WITH (security_invoker = true); otherwise revoke anon/authenticated or use an unexposed schema."}, {"id": "_agents_skills_supabase_skill_update_requires_select_policy", "label": "UPDATE requires a SELECT policy", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Without a SELECT policy updates silently affect 0 rows."}, {"id": "_agents_skills_supabase_skill_auth_role_deprecation", "label": "auth.role() deprecated in favour of TO clause", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "auth.role() = 'authenticated' also passes anonymous sign-ins, which carry the authenticated role."}, {"id": "_agents_skills_supabase_skill_bola_ownership_predicate", "label": "TO authenticated needs an ownership predicate (BOLA/IDOR)", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Role check is authentication without authorization; combine with (select auth.uid()) = user_id."}, {"id": "_agents_skills_supabase_skill_update_with_check", "label": "UPDATE policies need USING and WITH CHECK", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Without WITH CHECK a user can reassign a row's user_id to someone else."}, {"id": "_agents_skills_supabase_skill_security_definer_bypass", "label": "SECURITY DEFINER functions bypass RLS", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Never add it to fix a permission error; prefer SECURITY INVOKER. In public it is callable by anon/authenticated via PUBLIC EXECUTE, so keep it in a non-exposed schema with an auth.uid() check."}, {"id": "_agents_skills_supabase_skill_storage_upsert_permissions", "label": "Storage upsert needs INSERT + SELECT + UPDATE", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "INSERT alone allows uploads but file replacement silently fails."}, {"id": "_agents_skills_supabase_skill_supply_chain_pinning", "label": "Pin Supabase package versions and commit lockfiles", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "npm supply-chain security for supabase-js, @supabase/ssr, supabase-py."}], "edges": [{"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_verify_against_changelog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": "L13", "weight": 1.0}, {"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_verify_your_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": "L18", "weight": 1.0}, {"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_recover_dont_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": "L21", "weight": 1.0}, {"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_data_api_exposure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": "L24", "weight": 1.0}, {"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_rls_exposed_schemas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": "L30", "weight": 1.0}, {"source": "_agents_skills_supabase_skill", "target": "_agents_skills_supabase_skill_s